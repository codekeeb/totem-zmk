/*
 * TOTEM - CODE/KEEB base firmware.
 *
 * 38 keys: 3x5 column-staggered per half, plus an outer key on each side
 * of the home row and 3 thumbs per half.
 *
 * Layers: BASE (QWERTY), LOWER (numbers + navigation), RAISE (symbols),
 * ADJUST (bluetooth, reset, output) reached by holding LOWER and RAISE
 * together.
 *
 * ZMK Studio: hold LOWER and press Z to unlock the keymap for editing.
 * The board boots locked (CONFIG_ZMK_STUDIO_LOCKING in totem_left.conf),
 * so a Studio client can connect and read the layout but cannot change
 * anything until that key is pressed. This stops a stray connection --
 * or someone else's browser -- from rewriting the keymap.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        // Holding both thumb layer keys reaches ADJUST.
        adjust {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "BASE";
// ╭────────┬────────┬────────┬────────┬────────╮   ╭────────┬────────┬────────┬────────┬────────╮
// │   Q    │   W    │   E    │   R    │   T    │   │   Y    │   U    │   I    │   O    │   P    │
// ├────────┼────────┼────────┼────────┼────────┤   ├────────┼────────┼────────┼────────┼────────┤
// │   A    │   S    │   D    │   F    │   G    │   │   H    │   J    │   K    │   L    │   ;    │
// ├────────┼────────┼────────┼────────┼────────┤   ├────────┼────────┼────────┼────────┼────────┤
// │   Z    │   X    │   C    │   V    │   B    │   │   N    │   M    │   ,    │   .    │   /    │
// ╰────────┴────────┴───┬────┴───┬────┴───┬────╯   ╰───┬────┴───┬────┴───┬────┴────────┴────────╯
//                       │  TAB   │ LOWER  │ SPACE │ ENTER │ RAISE  │ BSPC │
//                       ╰────────┴────────┴───────┴───────┴────────┴──────╯
            bindings = <
             &kp Q      &kp W      &kp E      &kp R      &kp T         &kp Y      &kp U      &kp I      &kp O      &kp P
             &kp A      &kp S      &kp D      &kp F      &kp G         &kp H      &kp J      &kp K      &kp L      &kp SEMI
  &kp ESC    &kp Z      &kp X      &kp C      &kp V      &kp B         &kp N      &kp M      &kp COMMA  &kp DOT    &kp FSLH   &kp SQT
                                   &kp TAB    &mo LOWER  &kp SPACE     &kp RET    &mo RAISE  &kp BSPC
            >;
        };

        lower_layer {
            display-name = "LOWER";
// ╭────────┬────────┬────────┬────────┬────────╮   ╭────────┬────────┬────────┬────────┬────────╮
// │   1    │   2    │   3    │   4    │   5    │   │   6    │   7    │   8    │   9    │   0    │
// ├────────┼────────┼────────┼────────┼────────┤   ├────────┼────────┼────────┼────────┼────────┤
// │ SHIFT  │ CTRL   │  ALT   │  GUI   │  HOME  │   │  LEFT  │  DOWN  │   UP   │ RIGHT  │  END   │
// ├────────┼────────┼────────┼────────┼────────┤   ├────────┼────────┼────────┼────────┼────────┤
// │ STUDIO │  CUT   │  COPY  │ PASTE  │ PG UP  │   │ PG DN  │  MUTE  │ VOL-   │ VOL+   │  PLAY  │
// ╰────────┴────────┴───┬────┴───┬────┴───┬────╯   ╰───┬────┴───┬────┴───┬────┴────────┴────────╯
//                       │        │ (held) │       │       │        │  DEL │
//                       ╰────────┴────────┴───────┴───────┴────────┴──────╯
//
// STUDIO = &studio_unlock: unlocks the keymap for ZMK Studio editing.
            bindings = <
             &kp N1        &kp N2     &kp N3     &kp N4     &kp N5        &kp N6     &kp N7      &kp N8       &kp N9       &kp N0
             &kp LSHFT     &kp LCTRL  &kp LALT   &kp LGUI   &kp HOME      &kp LEFT   &kp DOWN    &kp UP       &kp RIGHT    &kp END
  &trans     &studio_unlock &kp LC(X) &kp LC(C)  &kp LC(V)  &kp PG_UP     &kp PG_DN  &kp C_MUTE  &kp C_VOL_DN &kp C_VOL_UP &kp C_PP  &trans
                                      &trans     &trans     &trans        &trans     &trans      &kp DEL
            >;
        };

        raise_layer {
            display-name = "RAISE";
// ╭────────┬────────┬────────┬────────┬────────╮   ╭────────┬────────┬────────┬────────┬────────╮
// │   !    │   @    │   #    │   $    │   %    │   │   ^    │   &    │   *    │   (    │   )    │
// ├────────┼────────┼────────┼────────┼────────┤   ├────────┼────────┼────────┼────────┼────────┤
// │   -    │   =    │   [    │   ]    │   \    │   │   `    │   '    │   ,    │   .    │   /    │
// ├────────┼────────┼────────┼────────┼────────┤   ├────────┼────────┼────────┼────────┼────────┤
// │   _    │   +    │   {    │   }    │   |    │   │   ~    │   "    │   <    │   >    │   ?    │
// ╰────────┴────────┴───┬────┴───┬────┴───┬────╯   ╰───┬────┴───┬────┴───┬────┴────────┴────────╯
//                       │        │        │       │       │ (held) │      │
//                       ╰────────┴────────┴───────┴───────┴────────┴──────╯
            bindings = <
             &kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT     &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR   &kp RPAR
             &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT   &kp BSLH      &kp GRAVE  &kp SQT    &kp COMMA  &kp DOT    &kp FSLH
  &trans     &kp UNDER  &kp PLUS   &kp LBRC   &kp RBRC   &kp PIPE      &kp TILDE  &kp DQT    &kp LT     &kp GT     &kp QMARK &trans
                                   &trans     &trans     &trans        &trans     &trans     &trans
            >;
        };

        adjust_layer {
            display-name = "ADJ";
// Reached by holding LOWER and RAISE together.
// ╭────────┬────────┬────────┬────────┬────────╮   ╭────────┬────────┬────────┬────────┬────────╮
// │  BT 1  │  BT 2  │  BT 3  │  BT 4  │  BT 5  │   │   F1   │   F2   │   F3   │   F4   │   F5   │
// ├────────┼────────┼────────┼────────┼────────┤   ├────────┼────────┼────────┼────────┼────────┤
// │BT CLEAR│        │        │        │ USB/BT │   │   F6   │   F7   │   F8   │   F9   │  F10   │
// ├────────┼────────┼────────┼────────┼────────┤   ├────────┼────────┼────────┼────────┼────────┤
// │ BOOTLD │        │        │        │ RESET  │   │        │        │        │  F11   │  F12   │
// ╰────────┴────────┴───┬────┴───┬────┴───┬────╯   ╰───┬────┴───┬────┴───┬────┴────────┴────────╯
//                       │        │ (held) │       │       │ (held) │      │
//                       ╰────────┴────────┴───────┴───────┴────────┴──────╯
            bindings = <
             &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4    &kp F1     &kp F2     &kp F3     &kp F4     &kp F5
             &bt BT_CLR   &none        &none        &none        &out OUT_TOG    &kp F6     &kp F7     &kp F8     &kp F9     &kp F10
  &trans     &bootloader  &none        &none        &none        &sys_reset      &none      &none      &none      &kp F11    &kp F12  &trans
                                       &trans       &trans       &trans          &trans     &trans     &trans
            >;
        };
    };
};
